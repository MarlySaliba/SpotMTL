# API settings
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection
# DATABASE_URL takes precedence when it is not empty. It is commonly supplied
# by managed PostgreSQL providers. For local development, leave it empty and
# use the individual DB_* values below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spotmtl
DB_USER=spotmtl_app
DB_PASSWORD=replace-with-your-local-password

# Leave DB_SSL empty to use the PostgreSQL driver's default or URL settings.
# Set it to true for providers that require TLS. Certificate verification stays
# enabled unless your provider explicitly instructs you otherwise.
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=true

# Connection-pool settings
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
